/* =====================================================================
   Gameplay HUD — transparent in-race overlay. Only the player control
   buttons (steer L/R, jump, double-jump, booster) and pause. The live
   race renders behind it. Laid out in 1920x1080 reference space,
   anchored to the bottom/right edges so it survives narrow aspects.
   ===================================================================== */

.hud-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* circular control buttons — each sprite has its frame baked in (181x187).
   Mock ring diameter ~145px, bumped 1.4x for comfortable touch targets. */
.hud-ctrl {
    position: absolute;
    width: 244px;
    height: 252px;
    -unity-background-scale-mode: scale-to-fit;
}

/* steering arrows read a touch larger than the action cluster (as in the mock) */
.hud-arrow {
    position: absolute;
    width: 286px;
    height: 295px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- bottom-left steering ----------------------------------------- */
.hud-left  { left: 50px;  bottom: 50px;
    background-image: url("../../../Art/UI/gameplay/left.png"); }
.hud-right { left: 360px; bottom: 50px;
    background-image: url("../../../Art/UI/gameplay/right.png"); }

/* ---- bottom-right action cluster: diamond spread so the button BOXES
        never overlap (16px+ gaps even before the art's circular padding) -- */
/* white booster (top point, directly above jump) */
.hud-booster-w { right: 266px; bottom: 318px;
    background-image: url("../../../Art/UI/gameplay/booster.png"); }
/* double-jump skater (right point, vertically centred between them) */
.hud-djump     { right: 6px;   bottom: 176px;
    background-image: url("../../../Art/UI/gameplay/double%20jump.png"); }
/* jump skater (bottom point) */
.hud-jump      { right: 266px; bottom: 50px;
    background-image: url("../../../Art/UI/gameplay/jump.png"); }

/* ---- top-right pause (glyph has no frame baked in; add a soft chip) -- */
.hud-pause {
    position: absolute;
    right: 60px; top: 120px;
    width: 131px; height: 131px;
    border-radius: 29px;
    background-color: rgba(8, 8, 9, 0.55);
    align-items: center;
    justify-content: center;
}
.hud-pause-icon {
    width: 60px; height: 74px;
    background-image: url("../../../Art/UI/gameplay/Pause.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- top-left position/rank pill (minimal overlay) ----------------- */
.hud-rank {
    position: absolute;
    left: 70px; top: 110px;
    min-width: 118px; height: 70px;
    padding-left: 20px; padding-right: 20px;
    background-color: rgba(8, 8, 9, 0.5);
    border-radius: 16px;
    align-items: center;
    justify-content: center;
}
.hud-rank-label {
    color: var(--text-light);
    font-size: 40px;
    -unity-font-definition: var(--font);
    -unity-font-style: bold;
}

/* ---- top-center live score + combo ---------------------------------- */
.hud-score {
    position: absolute;
    top: 36px; left: 0; right: 0;
    align-items: center;
    justify-content: flex-start;
}
.hud-score-label {
    color: var(--text-light);
    font-size: 66px;
    -unity-font-definition: var(--font);
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}
.hud-combo-label {
    color: var(--accent);
    font-size: 46px;
    -unity-font-definition: var(--font);
    -unity-font-style: bold-and-italic;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.6);
}

/* ---- centered 3-2-1-GO countdown ----------------------------------- */
.hud-countdown {
    position: absolute;
    left: 0; right: 0; top: 330px;
    -unity-text-align: middle-center;
    color: var(--accent);
    font-size: 220px;
    -unity-font-definition: var(--font);
    -unity-font-style: bold;
}
