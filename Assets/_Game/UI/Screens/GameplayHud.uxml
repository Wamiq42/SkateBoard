<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/_Game/UI/Styles/mixtape.uss" />
    <Style src="project://database/Assets/_Game/UI/Screens/GameplayHud.uss" />

    <!-- transparent overlay: the live race renders behind this. Only the player
         control buttons + pause live here (nothing else, per the design). -->
    <ui:VisualElement name="root" class="screen hud-root" picking-mode="Ignore">

        <!-- top-right pause -->
        <ui:Button name="pause-btn" class="sprite-btn hud-pause">
            <ui:VisualElement name="pause-icon" class="hud-pause-icon" picking-mode="Ignore" />
        </ui:Button>

        <!-- top-left position/rank pill (minimal overlay, not in the mock) -->
        <ui:VisualElement name="rank-pill" class="hud-rank" picking-mode="Ignore">
            <ui:Label name="rank-label" text="1/3" class="hud-rank-label" />
        </ui:VisualElement>

        <!-- top-center live score + combo readout (revealed on GO) -->
        <ui:VisualElement name="score-pill" class="hud-score is-hidden" picking-mode="Ignore">
            <ui:Label name="score-label" text="0" class="hud-score-label" />
            <ui:Label name="combo-label" text="" class="hud-combo-label is-hidden" />
        </ui:VisualElement>

        <!-- centered 3-2-1-GO countdown (transient; toggled by the view) -->
        <ui:Label name="countdown" text="" class="hud-countdown is-hidden" picking-mode="Ignore" />

        <!-- bottom-left steering -->
        <ui:Button name="left-btn"  class="sprite-btn hud-arrow hud-left" />
        <ui:Button name="right-btn" class="sprite-btn hud-arrow hud-right" />

        <!-- bottom-right action cluster: white booster, double-jump and jump. -->
        <ui:Button name="booster2-btn" class="sprite-btn hud-ctrl hud-booster-w" />
        <ui:Button name="djump-btn"    class="sprite-btn hud-ctrl hud-djump" />
        <ui:Button name="jump-btn"     class="sprite-btn hud-ctrl hud-jump" />

    </ui:VisualElement>
</ui:UXML>
